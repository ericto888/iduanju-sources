{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iDuanJu Source Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "updatedAt",
    "categories",
    "plugins"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "manifest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+){2,}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "manifest": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://raw\\.githubusercontent\\.com/ericto888/iduanju-sources/main/sources/.+/manifest\\.json$"
          },
          "type": {
            "enum": [
              "video",
              "shortdrama",
              "comic",
              "live"
            ]
          },
          "adult": {
            "type": "boolean"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "author": {
            "type": "string"
          }
        }
      }
    }
  }
}
